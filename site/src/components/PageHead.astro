---
// 研究室サイト(kawahara-lab-site 2231987 の src/components/PageHead.astro)からコピーした
// 各ページの冒頭: 英語ラベル(Mono)、H1、リード文
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<section class="container page-head">
  <span class="label mono">{label}</span>
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</section>

<style>
  .page-head {
    padding-top: 88px;
  }
  .label {
    font-size: 12px;
    color: var(--color-text-sub);
  }
  h1 {
    margin: 4px 0 0;
    font-size: var(--font-size-h1);
    line-height: 1.5;
    letter-spacing: 0.06em;
  }
  .lead {
    margin: 12px 0 0;
    color: var(--color-text-sub);
    max-width: var(--measure);
  }
</style>
