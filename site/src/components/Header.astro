---
// 企画名と添え書き、ナビ。現在のページは紺の下線と aria-current
import { href } from "../lib/url";
import { SITE } from "../site.config";

export type NavKey = "exhibits";

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;
const items: { key: NavKey; path: string; label: string }[] = [
  { key: "exhibits", path: "/exhibits/", label: "展示紹介" },
];
---

<header class="header">
  <div class="container inner">
    <a class="brand" href={href("/")}>
      <span class="name">{SITE.name}</span>
      <span class="name-sub">{SITE.nameSub}</span>
    </a>
    <nav class="nav" aria-label="サイト内">
      {items.map((item) => (
        <a href={href(item.path)} aria-current={current === item.key ? "page" : undefined}>
          {item.label}
        </a>
      ))}
      <a href={SITE.labSiteUrl}>研究室サイト</a>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-line);
  }
  .inner {
    padding-top: 20px;
    padding-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    padding: 6px 0;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.5;
  }
  .name {
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 0.08em;
  }
  .name-sub {
    font-size: 12px;
    color: var(--color-text-sub);
    letter-spacing: 0.04em;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
    font-size: 14px;
  }
  .nav > a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .nav > a:hover {
    color: var(--color-navy);
  }
  .nav > a[aria-current="page"] {
    border-bottom-color: var(--color-navy);
  }
  @media (max-width: 640px) {
    .nav {
      gap: 0 20px;
    }
  }
</style>
