---
import { href } from "../lib/url";
import { SITE } from "../site.config";
---

<footer class="footer">
  <div class="container inner">
    <div class="about">
      <span class="name">{SITE.name}</span>
      <span>{SITE.nameSub}</span>
    </div>
    <div class="links">
      <a href={href("/exhibits/")}>展示紹介</a>
      <a href={SITE.labSiteUrl}>研究室サイト</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
  }
  .inner {
    padding-top: 56px;
    padding-bottom: 56px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px 48px;
    font-size: 14px;
    color: var(--color-text-sub);
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .name {
    font-weight: 600;
    font-size: 16px;
    color: var(--color-text);
    letter-spacing: 0.08em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text-sub);
  }
</style>
