---
// 研究室サイト(kawahara-lab-site 2231987 の src/components/Hero.astro)からコピーした。正本は研究室サイトにある
// トップのみ。角丸の面の中で、有名なグラフが回転し、その上を信号が伝わる(src/hero/)。
// ドラッグで回り、クリックで形ごとの処理(探索・塗り分け)を実行する。
// prefers-reduced-motion では止まった1枚を表示する。JavaScript が無ければ面だけが残る
---

<div class="hero" data-hero>
  <canvas aria-hidden="true"></canvas>
  <p class="shape-name mono" aria-hidden="true">
    <span data-shape-name></span>
    <span data-algo-name></span>
  </p>
</div>

<script>
  import { startHero } from "../hero/main";

  const el = document.querySelector<HTMLElement>("[data-hero]");
  if (el) startHero(el);
</script>

<style>
  .hero {
    /* ヒーローの描画色(src/hero/palette.ts が読む)。サイトの配色に合わせ、明るい配色に固定する */
    --bg: #f4f6f9;
    --ink: #121a2b;
    --muted: #5a667c;
    --line: #d5dbe5;
    --edge: #bcc6d6;
    --accent: #1b5faa; /* ロゴの青 */
    --accent2: #e0a730; /* ロゴの金。白地で文字に使えないので、装飾だけに使う */
    --c3: #1f9e74;
    --c4: #d6456a;
    --c5: #7d55d9;
    --c6: #0f8ba0;
    --c7: #a8860a;

    position: relative;
    height: 460px;
    border-radius: var(--radius-hero);
    background: var(--color-surface);
    overflow: hidden;
    touch-action: pan-y;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  .hero:global(.dragging) canvas {
    cursor: grabbing;
  }
  .shape-name {
    position: absolute;
    right: 24px;
    bottom: 14px;
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-text-sub);
    pointer-events: none;
  }
  [data-algo-name]:not(:empty)::before {
    content: " · ";
  }
  @media (max-width: 640px) {
    .hero {
      height: 320px;
    }
  }
  /* 検証用の図形切り替え(開発サーバーか ?dev のときだけ出る) */
  :global(nav.dev) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    padding: 12px 0;
    font-size: 13px;
    color: var(--color-text-sub);
  }
  :global(nav.dev .tag) {
    font-family: var(--font-mono);
    font-size: 11px;
  }
  :global(nav.dev button) {
    font: inherit;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 3px 11px;
    cursor: pointer;
  }
  :global(nav.dev button[aria-pressed="true"]) {
    background: var(--color-navy);
    color: var(--color-bg);
  }
</style>
